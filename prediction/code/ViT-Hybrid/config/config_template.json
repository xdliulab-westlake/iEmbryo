{
  "_description": "ViT-Hybrid Configuration Template",
  "_usage": "Copy and edit this file, then use: python main.py train --data_root /liaozizhuo/ --multi_focal ... --config_file your_config.json",
  "_doc_url": "See README.md for detailed parameter explanations",

  "model": {
    "TIME_STEPS": 33,
    "FOCAL_PLANES": 11,
    "IMAGE_SIZE": 224,
    "NUM_TRANSFORMER_LAYERS": 4,
    "NUM_HEADS": 8,
    "D_MODEL": 4096,
    "DFF": 2048,
    "DROPOUT_RATE": 0.1,
    "FUSION_TYPE": "average"
  },

  "training": {
    "BATCH_SIZE": 4,
    "EPOCHS": 100,
    "LEARNING_RATE": 0.0001,
    "WEIGHT_DECAY": 0.00001,
    "TRAIN_RATIO": 0.7,
    "VAL_RATIO": 0.15,
    "EARLY_STOPPING_PATIENCE": 10,
    "REDUCE_LR_PATIENCE": 5,
    "REDUCE_LR_FACTOR": 0.5,
    "MIN_LR": 0.0000001,
    "MONITOR_METRIC": "val_auc",
    "MONITOR_MODE": "max",
    "NUM_WORKERS": 4,
    "PIN_MEMORY": true
  },

  "data": {
    "DATA_ROOT": "/liaozizhuo/",
    "SCORE_DICT_PATH": "/liaozizhuo/score_dict.json",
    "TEST_RATIO": 0.15,
    "APPLY_PETRI_CROP": true,
    "APPLY_CENTER_CROP": true
  },

  "paths": {
    "MODEL_SAVE_DIR": "/liaozizhuo/scripts/ViT-Hybrid/checkpoints",
    "LOG_DIR": "/liaozizhuo/scripts/ViT-Hybrid/logs",
    "RESULT_DIR": "/liaozizhuo/scripts/ViT-Hybrid/results",
    "CACHE_DIR": "/liaozizhuo/scripts/ViT-Hybrid/cache"
  }
}
